{
  "name": "dsh-session-history-ui",
  "version": "1.0.4",
  "description": "Right-sidebar session history and branch browser for DeepSeek Harness: browse this conversation's turns, jump the chat to any turn, filter user messages, and see every conversation with its forked branches.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check client.js && node --check index.js"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "session-history",
    "branches",
    "sidebar",
    "chat-ui"
  ],
  "author": "pokereva",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pokereva/dsh-session-history-ui.git"
  },
  "homepage": "https://github.com/pokereva/dsh-session-history-ui",
  "bugs": {
    "url": "https://github.com/pokereva/dsh-session-history-ui/issues"
  }
}
